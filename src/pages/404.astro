---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout lang="en" noindex title="Page not found — INSPOSOFT" description="The page you requested could not be found.">
  <main id="main" class="legal-page">
    <div class="legal-top"><a class="wordmark" href="/">INSPO<strong>SOFT</strong></a><a class="language-switch" href="/tr/404/">TR <span aria-hidden="true">↗</span></a></div>
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or has moved. If you followed a link, please try the INSPOSOFT homepage.</p>
    <a class="text-link" href="/">← Back to INSPOSOFT</a>
  </main>
  <script is:inline>
    // The assets-only Worker serves this root 404 page for every unknown path,
    // including /tr/*. When that happens, switch the copy to Turkish while
    // keeping the real 404 status (the standalone /tr/404/ page is untouched).
    if (/^\/tr(\/|$)/.test(location.pathname)) {
      document.documentElement.lang = 'tr';
      document.title = 'Sayfa bulunamadı — INSPOSOFT';
      const desc = document.querySelector('meta[name="description"]');
      if (desc) desc.setAttribute('content', 'İstediğiniz sayfa bulunamadı.');
      const main = document.querySelector('#main');
      if (main) {
        const wordmark = main.querySelector('.wordmark');
        if (wordmark) wordmark.setAttribute('href', '/tr/');
        const switchLink = main.querySelector('.language-switch');
        if (switchLink) {
          switchLink.setAttribute('href', '/404/');
          const label = switchLink.firstChild;
          if (label && label.nodeType === Node.TEXT_NODE) label.nodeValue = 'EN ';
        }
        const h1 = main.querySelector('h1');
        if (h1) h1.textContent = 'Sayfa bulunamadı';
        const p = main.querySelector('p:not(.eyebrow)');
        if (p) p.textContent = 'Aradığınız sayfa mevcut değil veya taşınmış olabilir. Bir bağlantıyı izlediyseniz lütfen INSPOSOFT ana sayfasını deneyin.';
        const back = main.querySelector('.text-link');
        if (back) {
          back.setAttribute('href', '/tr/');
          back.textContent = '← INSPOSOFT ana sayfasına dön';
        }
      }
    }
  </script>
</BaseLayout>
