---

<header class="site-header">
  <div class="site-header-inner">
    <a class="wordmark" href={tr ? '/tr/' : '/'} aria-label={tr ? 'INSPOSOFT ana sayfa' : 'INSPOSOFT home'}><span>INSPO</span><strong>SOFT</strong></a>
    <nav class="desktop-nav" aria-label={copy.navMainLabel}>
      <a href="#work">{copy.navWork}</a>
      <a href="#systems">{copy.navSystems}</a>
      <a href="#approach">{copy.navApproach}</a>
      <a href="#contact">{copy.navContact}</a>
    </nav>
    <div class="header-actions">
      <a class="language-switch" href={tr ? '/' : '/tr/'}>{tr ? 'EN' : 'TR'} <span aria-hidden="true">↗</span></a>
      <a class="header-cta" href="#contact">{copy.navCta} <span aria-hidden="true">↗</span></a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label={copy.navOpen}>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label={copy.navMenuLabel} hidden>
    <a href="#work">{copy.navWork}</a>
    <a href="#systems">{copy.navSystems}</a>
    <a href="#approach">{copy.navApproach}</a>
    <a href="#contact">{copy.navContact}</a>
    <a class="mobile-cta" href="#contact">{copy.navCta} <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<main id="main">
  <section class="hero section-grid" id="top">
    <div class="hero-copy reveal">
      <p class="eyebrow">{copy.heroKicker}</p>
      <h1>{copy.heroTitle}</h1>
      <p class="hero-lead">{copy.heroText}</p>
      <p class="hero-note">{copy.heroNote}</p>
      <div class="hero-actions">
        <a class="button button-dark" href="#contact">{copy.heroCta} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#work">{copy.heroExplore} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <TechnicalHero lang={lang} />
    <div class="hero-footer">
      <span>{copy.heroFooterOne}</span>
      <span>{copy.heroFooterTwo}</span>
      <span>{tr ? 'MÜHENDİSLİK STÜDYOSU' : 'ENGINEERING STUDIO'}</span>
    </div>
  </section>

  <section class="intro section-grid" id="work">
    <div class="section-index">{copy.introLabel}</div>
    <div class="intro-copy">
      <h2>{copy.introTitle}</h2>
      <p>{copy.introText}</p>
    </div>
  </section>

  <section class="capabilities" id="systems">
    <div class="capabilities-intro section-grid">
      <div class="section-index">{copy.systemsLabel}</div>
      <div class="capabilities-intro-copy">
        <h2>{copy.systemsTitle}</h2>
        <p>{copy.systemsText}</p>
      </div>
    </div>
    <article class="capability capability-energy reveal">
      <div class="capability-number">01</div>
      <div>
        <p class="eyebrow">{copy.energyLabel}</p>
        <h3>{copy.energyTitle}</h3>
        <p>{copy.energyText}</p>
        <p class="output-line">{copy.energyOutput}</p>
        <p class="capability-decision"><strong>{copy.energyDecision}</strong><span>{copy.energyReview}</span></p>
      </div>
      <div class="mini-visual battery-visual" role="img" aria-label={copy.demoBobo}>
        <div class="chart-label">{copy.energyChartLabel}</div>
