---
import TechnicalHero from './TechnicalHero.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  lang: 'en' | 'tr';
}

const { lang } = Astro.props;
const tr = lang === 'tr';
const copy = tr ? {
  navWork: 'Çalışmalar', navApproach: 'Yaklaşım', navContact: 'İletişim',
  heroKicker: 'MÜHENDİSLİK YAZILIMI · ALAN YÖNTEMLERİ',
  heroTitle: 'İncelenebilir kararlar için mühendislik araçları.',
  heroText: 'INSPOSOFT; enerji depolama, hidroloji, su sistemleri ve taşkın mühendisliği için alan bilgisine dayalı yazılımlar ve hesaplamalı araçlar geliştirir.',
  heroNote: 'Veriyi, varsayımları, yöntemleri ve sınırları görünür kılarak teknik ekiplerin sonuca harekete geçmeden önce bakmasını sağlarız.',
  heroCta: 'Teknik bir görüşme başlat', heroExplore: 'Neler geliştiriyoruz?',
  introLabel: '01 · NE YAPIYORUZ', introTitle: 'Karmaşık mühendislik verisini, birlikte incelenebilecek kararlara dönüştürüyoruz.',
  introText: 'Tek bir “AI” anlatısı yerine; kaynak veriyi, mühendislik yöntemini, varsayımları ve çıktıyı aynı çerçevede tutan araçlar geliştiriyoruz.',
  energyLabel: 'ENERJİ · BOBO', energyTitle: 'Yenilenebilir tesislerin arkasındaki batarya senaryolarını görün.', energyText: 'EPİAŞ fiyat ve üretim verileriyle saatlik işletme, kapasite ve ekonomik varsayımları birlikte inceleyen BESS senaryo analizi.',
  energyOutput: 'Çıktı: dispatch · sizing · ekonomik duyarlılık', energyTag: 'MEVCUT UYGULAMA',
  hydroLabel: 'HİDROLOJİ · AĞKOLU · KEMERÇAYIR · ALMUS', hydroTitle: 'Baraj ve HES sahaları için günlük akış görünümü.', hydroText: 'Gözlenen akış, hava ve kar sinyallerini bir araya getiren, adlandırılmış sahalara göre yapılandırılmış 16 günlük akış tahmini uygulamaları.',
  hydroOutput: 'Çıktı: günlük tahmin · grafik · doğrulama görünümü', hydroTag: 'SAHA ÖZELİNDE',
  floodLabel: 'TAŞKIN MÜHENDİSLİĞİ · TAŞKIN HESAP', floodTitle: 'Havza haritasından incelenebilir taşkın çalışmasına.', floodText: 'Havza, zemin, Thiessen yağışı, sentetik yöntemler, frekans analizi, öteleme ve rapor çıktısını tek bir hesap akışında birleştirir.',
  floodOutput: 'Çıktı: hidrograf · karşılaştırma · rapor · dışa aktarım', floodTag: 'HESAPLAMA AKIŞI',
  evidenceLabel: '02 · KANIT VE YAKLAŞIM', evidenceTitle: 'Güven, yöntemin arkasına değil içine yerleştirilir.', evidenceText: 'Bir aracın değerini yalnızca algoritma sayısı belirlemez. Verinin nereden geldiğini, hangi varsayımın etkili olduğunu ve sonucun neyi kanıtlamadığını göstermek gerekir.',
  proofOne: 'Alan yöntemleri', proofOneText: 'Dinamik programlama, hava/kar özellikleri, sentetik taşkın yöntemleri, frekans analizi ve rezervuar ötelemesi.', proofTwo: 'İncelenebilir çıktılar', proofTwoText: 'Senaryolar, tahmin tabloları, hidrograflar, rapor bölümleri ve veri dışa aktarımları.', proofThree: 'Açık sınırlar', proofThreeText: 'Model çıktıları mühendislik incelemesini destekler; evrensel doğruluk veya düzenleyici onay iddiası taşımaz.',
  teamLabel: '03 · MÜHENDİSLİK YARGISI', teamTitle: 'Yazılım güçlüdür. Bağlam hâlâ önemlidir.',  teamText: 'INSPOSOFT, mühendislik problemleri ile yazılım geliştirmeyi aynı çalışma çerçevesinde ele alarak teknik kararları karşılaştırılabilir, tartışılabilir ve incelenebilir kılmayı amaçlar.', teamNote: 'Ekip profilleri ve geçmiş proje kayıtları onaylandıkça bu alan gerçek isimler, roller ve yayınlanabilir deneyimle genişletilecektir.',
  demoLabel: 'TEKNİK GÖSTERİM', demoTitle: 'Gerçek çıktılara benzeyen değil, gerçek yöntemleri gösteren görseller.', demoBobo: 'Sentetik BESS dispatch senaryosu', demoHydro: '16 günlük akış tahmin görünümü', demoFlood: 'Havzadan hidrografa hesap akışı',
  archiveLabel: '04 · ARAŞTIRMA GEÇMİŞİ', archiveTitle: 'Bugünkü araçlardan önce gelen bir yöntem çizgisi.', archiveText: 'Rezervuar kısıntısı, su dengesi, hidro ünite dağılımı ve optimizasyon üzerine eski çalışmalar metodolojik bir arşiv olarak korunmaktadır.', archiveStatus: 'ARŞİVLENMİŞ ARAŞTIRMA · GÜNCEL ÜRÜN DEĞİL',
  contactLabel: '05 · İLETİŞİM', contactTitle: 'Önünüzde zor bir mühendislik kararı mı var?', contactText: 'Ne anlamaya çalıştığınızı anlatın. Görüşmeyi enerji, hidroloji, taşkın veya yöntemler alanına yönlendirelim.', footerText: 'Enerji · Hidroloji · Taşkın mühendisliği · Araştırma', privacy: 'Gizlilik', terms: 'Koşullar',
} : {
  navWork: 'Work', navApproach: 'Approach', navContact: 'Contact',
  heroKicker: 'ENGINEERING SOFTWARE · DOMAIN METHODS',
  heroTitle: 'Engineering tools for decisions that need to hold up.',
  heroText: 'INSPOSOFT develops domain-specific software and computational tools for energy storage, hydrology, water systems, and flood engineering.',
  heroNote: 'We make data, assumptions, methods, and limitations visible—so technical teams can inspect the result before they act on it.',
  heroCta: 'Start a technical conversation', heroExplore: 'See what we build',
  introLabel: '01 · WHAT WE DO', introTitle: 'We turn difficult engineering data into decisions that can be reviewed together.',
  introText: 'Rather than hiding behind a generic “AI” story, we keep source data, engineering methods, assumptions, and outputs in the same frame.',
  energyLabel: 'ENERGY · BOBO', energyTitle: 'See what a battery could do behind a renewable plant.', energyText: 'BESS scenario analysis combining EPİAŞ price and generation data with hourly dispatch, capacity sizing, and economic assumptions.',
  energyOutput: 'Output: dispatch · sizing · economic sensitivity', energyTag: 'CURRENT APPLICATION',
  hydroLabel: 'HYDROLOGY · AĞKOLU · KEMERÇAYIR · ALMUS', hydroTitle: 'A daily inflow view for dam and HEPP sites.', hydroText: 'Site-configured 16-day inflow forecasting applications combining observed flow, weather, and snow signals.',
  hydroOutput: 'Output: daily forecast · charts · validation views', hydroTag: 'SITE-SPECIFIC',
  floodLabel: 'FLOOD ENGINEERING · TAŞKIN HESAP', floodTitle: 'From a basin map to an inspectable flood study.', floodText: 'A single computational workflow for basin, soil, Thiessen rainfall, synthetic methods, frequency analysis, routing, and report outputs.',
  floodOutput: 'Output: hydrograph · comparison · report · export', floodTag: 'COMPUTATIONAL WORKFLOW',
  evidenceLabel: '02 · EVIDENCE & APPROACH', evidenceTitle: 'Trust belongs inside the method, not after it.', evidenceText: 'A tool’s value is not measured by its algorithm count. It is measured by whether people can see where the data came from, which assumptions matter, and what the result does not prove.',
  proofOne: 'Domain methods', proofOneText: 'Dynamic programming, weather/snow features, synthetic flood methods, frequency analysis, and reservoir routing.', proofTwo: 'Reviewable outputs', proofTwoText: 'Scenarios, forecast tables, hydrographs, report sections, and exportable data.', proofThree: 'Honest boundaries', proofThreeText: 'Model outputs support engineering review; they do not claim universal accuracy or regulatory approval.',
  teamLabel: '03 · ENGINEERING JUDGMENT', teamTitle: 'Software is powerful. Context still matters.',  teamText: 'INSPOSOFT approaches engineering problems and software development within the same working frame, making technical decisions comparable, discussable, and reviewable.', teamNote: 'This section will expand with approved names, roles, and publishable experience as the team profile and project record are finalized.',
  demoLabel: 'TECHNICAL DEMONSTRATIONS', demoTitle: 'Visuals that show real methods, not just realistic-looking outputs.', demoBobo: 'Synthetic BESS dispatch scenario', demoHydro: '16-day inflow forecast view', demoFlood: 'Basin-to-hydrograph workflow',
  archiveLabel: '04 · RESEARCH LINEAGE', archiveTitle: 'A line of methods that predates today’s tools.', archiveText: 'Earlier work in reservoir rationing, water balance, hydro-unit allocation, and optimization remains available as a historical methodology reference.', archiveStatus: 'ARCHIVED RESEARCH · NOT A CURRENT PRODUCT',
  contactLabel: '05 · CONTACT', contactTitle: 'Have a difficult engineering decision in front of you?', contactText: 'Tell us what you are trying to understand. We will route the conversation to the relevant energy, hydrology, flood, or methods capability.', footerText: 'Energy · Hydrology · Flood engineering · Research', privacy: 'Privacy', terms: 'Terms',
};
---

<header class="site-header">
  <a class="wordmark" href={tr ? '/tr/' : '/'} aria-label="INSPOSOFT home"><span>INSPO</span><strong>SOFT</strong></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    <a href="#work">{copy.navWork}</a><a href="#approach">{copy.navApproach}</a><a href="#contact">{copy.navContact}</a>
  </nav>
  <div class="header-actions">
    <a class="language-switch" href={tr ? '/' : '/tr/'}>{tr ? 'EN' : 'TR'} <span aria-hidden="true">↗</span></a>
    <a class="header-cta" href="#contact">{tr ? 'Konuşalım' : 'Let’s talk'} <span aria-hidden="true">↗</span></a>
  </div>
</header>

<main>
  <section class="hero section-grid" id="top">
    <div class="hero-copy reveal">
      <p class="eyebrow">{copy.heroKicker}</p>
      <h1>{copy.heroTitle}</h1>
      <p class="hero-lead">{copy.heroText}</p>
      <p class="hero-note">{copy.heroNote}</p>
      <div class="hero-actions"><a class="button button-dark" href="#contact">{copy.heroCta} <span aria-hidden="true">↗</span></a><a class="text-link" href="#work">{copy.heroExplore} <span aria-hidden="true">↓</span></a></div>
    </div>
    <TechnicalHero />
    <div class="hero-footer"><span>INSPO / 001</span><span>38° 57′ N · 35° 14′ E</span><span>{tr ? 'MÜHENDİSLİK STÜDYOSU' : 'ENGINEERING STUDIO'}</span></div>
  </section>

  <section class="intro section-grid" id="work">
    <div class="section-index">{copy.introLabel}</div>
    <div class="intro-copy"><h2>{copy.introTitle}</h2><p>{copy.introText}</p></div>
  </section>

  <section class="capabilities">
    <article class="capability capability-energy reveal">
      <div class="capability-number">01</div><div><p class="eyebrow">{copy.energyLabel}</p><h3>{copy.energyTitle}</h3><p>{copy.energyText}</p><p class="output-line">{copy.energyOutput}</p></div>
      <div class="mini-visual battery-visual" aria-label={copy.demoBobo}><div class="chart-label">PRICE / MW / SOC</div><svg viewBox="0 0 360 150" role="img" aria-hidden="true"><path d="M0 120h360M0 88h360M0 56h360" stroke="currentColor" opacity=".14"/><path d="M0 105c22-22 37-5 55-24 18-19 31-43 49-16 18 27 31-24 50-37 18-13 28 48 47 29 18-19 25-19 44-13 20 7 28-37 47-21 19 16 25 15 41-1 18-17 31 23 48 14 17-9 20-17 29-17" class="graph-line"/><path d="M0 132h58v-40h51v21h59v-58h63v45h72v-22h57" class="soc-line"/></svg><div class="visual-caption"><span>{copy.energyTag}</span><span>MODELLED SCENARIO</span></div></div>
      <div class="capability-tag">{copy.energyTag}</div>
    </article>
    <article class="capability capability-hydro reveal">
      <div class="capability-number">02</div><div><p class="eyebrow">{copy.hydroLabel}</p><h3>{copy.hydroTitle}</h3><p>{copy.hydroText}</p><p class="output-line">{copy.hydroOutput}</p></div>
      <div class="mini-visual hydro-visual" aria-label={copy.demoHydro}><div class="chart-label">Q / M³·S⁻¹ / 16 DAYS</div><svg viewBox="0 0 360 150" role="img" aria-hidden="true"><path d="M0 120h360M0 80h360M0 40h360" stroke="currentColor" opacity=".14"/><path d="M0 96c20-2 32-9 47-4 18 6 24 2 39 8 14 7 27-17 42-11 16 7 22 0 37-7 17-9 24-4 38-11 13-7 21-3 34 6 17 12 24 0 38 6 18 8 29 4 43 14 16 12 27 4 42 10 16 5 24 1 32 6" class="observed-line"/><path d="M0 104c19-5 34-2 49-7 17-5 28 5 43 0 16-5 28-11 42-5 16 7 25-7 40-5 17 2 22-2 37-9 15-7 26 3 40-1 17-4 28 7 43 2 16-5 26 2 39 3 13 2 22-3 27-2" class="forecast-line"/></svg><div class="visual-caption"><span>{copy.hydroTag}</span><span>Q₀ → DAY 16</span></div></div>
      <div class="capability-tag">{copy.hydroTag}</div>
    </article>
    <article class="capability capability-flood reveal">
      <div class="capability-number">03</div><div><p class="eyebrow">{copy.floodLabel}</p><h3>{copy.floodTitle}</h3><p>{copy.floodText}</p><p class="output-line">{copy.floodOutput}</p></div>
      <div class="mini-visual flood-visual" aria-label={copy.demoFlood}><div class="flow-steps"><span>DEM</span><i>→</i><span>CN</span><i>→</i><span>P</span><i>→</i><span>Q</span></div><svg viewBox="0 0 360 110" role="img" aria-hidden="true"><path d="M0 92h360" stroke="currentColor" opacity=".2"/><path d="M0 92c45 0 47-3 69-5 28-3 33-7 52-17 30-16 44-54 68-55 26-2 24 38 47 52 26 15 31 20 52 22 22 2 37 3 72 3" class="flood-line"/><path d="M0 92c45 0 53-2 75-6" stroke="#c86c47" stroke-width="2"/></svg><div class="visual-caption"><span>{copy.floodTag}</span><span>Q₂ — Q₁₀₀</span></div></div>
      <div class="capability-tag">{copy.floodTag}</div>
    </article>
  </section>

  <section class="evidence dark-section" id="approach">
    <div class="section-index light-index">{copy.evidenceLabel}</div><div class="evidence-intro"><h2>{copy.evidenceTitle}</h2><p>{copy.evidenceText}</p></div>
    <div class="proof-grid"><div class="proof-item"><span>01</span><h3>{copy.proofOne}</h3><p>{copy.proofOneText}</p></div><div class="proof-item"><span>02</span><h3>{copy.proofTwo}</h3><p>{copy.proofTwoText}</p></div><div class="proof-item"><span>03</span><h3>{copy.proofThree}</h3><p>{copy.proofThreeText}</p></div></div>
    <div class="evidence-foot"><span>METHODS / DATA / REVIEW</span><span>{tr ? 'Sınırlar, sonucun bir parçasıdır.' : 'Boundaries are part of the result.'}</span></div>
  </section>

  <section class="team section-grid"><div class="section-index">{copy.teamLabel}</div><div class="team-copy"><h2>{copy.teamTitle}</h2><p>{copy.teamText}</p><p class="muted-note">{copy.teamNote}</p><div class="discipline-list"><span>ENERGY</span><span>HYDROLOGY</span><span>FLOOD</span><span>GIS</span><span>OPTIMIZATION</span></div></div></section>

  <section class="demonstrations"><div class="section-index">{copy.demoLabel}</div><div class="demo-heading"><h2>{copy.demoTitle}</h2></div><div class="demo-grid"><div class="demo-card demo-bobo"><span class="demo-code">SYNTHETIC DEMONSTRATION</span><div class="demo-art"><div class="demo-battery"></div><div class="demo-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div><p>{copy.demoBobo}</p></div><div class="demo-card demo-hydro"><span class="demo-code">SYNTHETIC DEMONSTRATION</span><div class="demo-art"><svg viewBox="0 0 400 150" aria-hidden="true"><path d="M0 125h400M0 80h400M0 35h400" stroke="currentColor" opacity=".2"/><path d="M0 100c30 4 33-8 59-2 25 6 34 1 59-8 25-9 32 3 56-7 28-11 35-2 61-11 26-9 37 13 62 9 26-4 37 7 59 3 21-3 28 2 44-2" class="demo-curve"/></svg></div><p>{copy.demoHydro}</p></div><div class="demo-card demo-flood"><span class="demo-code">SYNTHETIC DEMONSTRATION</span><div class="demo-art"><svg viewBox="0 0 400 150" aria-hidden="true"><path d="M20 117h360M20 117V20" stroke="currentColor" opacity=".3"/><path d="M20 117c50 0 52-6 78-11 37-8 52-73 91-76 36-3 31 59 68 73 31 12 60 13 123 14" class="demo-curve flood-demo"/><path d="M20 117h360" stroke="#c86c47" stroke-width="2"/></svg></div><p>{copy.demoFlood}</p></div></div></section>

  <section class="archive dark-section"><div class="archive-mark" aria-hidden="true">↗</div><div><p class="eyebrow light-eyebrow">{copy.archiveLabel}</p><h2>{copy.archiveTitle}</h2><p>{copy.archiveText}</p><span class="archive-status">{copy.archiveStatus}</span></div></section>

  <section class="contact section-grid" id="contact"><div class="section-index">{copy.contactLabel}</div><div class="contact-copy"><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p><ContactForm lang={lang} /></div></section>
</main>

<footer class="site-footer"><div><a class="wordmark footer-mark" href={tr ? '/tr/' : '/'}>INSPO<strong>SOFT</strong></a><p>{copy.footerText}</p></div><div class="footer-links"><a href={tr ? '/tr/privacy/' : '/privacy/'}>{copy.privacy}</a><a href={tr ? '/tr/terms/' : '/terms/'}>{copy.terms}</a><a href="#top">↑ {tr ? 'Başa dön' : 'Back to top'}</a></div><div class="footer-meta"><span>© {new Date().getFullYear()} INSPOSOFT</span><span>insposoft.com</span></div></footer>
