# Contact delivery via Formspree (external form-to-email service).
# The form POSTs to this public endpoint; Formspree forwards submissions to the
# recipient configured in the Formspree dashboard. PUBLIC_ vars are inlined into
# the static build, so only the public endpoint goes here — never an API key.
PUBLIC_FORMSPREE_ENDPOINT=
# Informational only — the actual recipient/from addresses are configured in the
# Formspree dashboard and are not read by the static build.
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=
